# 复制成 .env 后填写真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会入库（§13.3、§18）

# 管理接口 Token（§3 P1-06）。变量名必须与 config.yaml 的
# security.admin_token_env 一致。留空则管理接口**无鉴权**，仅限本地开发。
# 生成一个：python -c "import secrets; print(secrets.token_urlsafe(32))"
SMARTMAAS_ADMIN_TOKEN=

# 日志级别：DEBUG / INFO / WARNING / ERROR
SMARTMAAS_LOG_LEVEL=INFO

# 以下为接真实后端时才需要（示例，按实验室实际情况填，不要提交）
# VLLM_API_KEY=
# REDIS_PASSWORD=
